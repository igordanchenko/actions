{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>igordanchenko/renovate:lib"],
  "packageRules": [
    {
      "description": "Group semantic-release toolchain bumps into a single PR",
      "matchFileNames": ["semantic-release/**"],
      "groupName": "semantic-release toolchain",
      "rangeStrategy": "pin"
    }
  ]
}
